# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# app-managed clone root (POST /api/projects/clone). Clones land in
# /projects/<owner>-<repo> and their worktrees in /projects/.arij-worktrees,
# so one entry covers both — keeps this repo clean when dogfooding Arij.
/projects

# misc
.DS_Store
*.pem

# app-managed clone root (see lib/projects/workspace.ts)
/projects

# test screenshots and debug dumps
test*.png
test-snapshot-*.md
.playwright-mcp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arij install.sh — machine-specific MCP config and its backups
/.mcp.json
*.arij-backup-*

# Claude Code local state — machine-specific permissions and agent worktrees.
# launch.json stays tracked (shared dev-server config).
/.claude/settings.local.json
/.claude/worktrees/
